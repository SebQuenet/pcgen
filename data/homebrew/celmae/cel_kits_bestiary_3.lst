# Bestiary 3 gives no default kit to the foo creatures, which Summon Good Monster lists.
# Alignment and base scores only: the sheet carries no feats or skill ranks for them.
STARTPACK:Foo Dog Default	TYPE:Default Monster.Outsider	VISIBLE:QUALIFY	EQUIPBUY:0	PREMULT:1,[PRERACE:1,Foo Dog],[!PRERACE:1,%]	SOURCEPAGE:Celmae
ALIGN:NG
RACE:Foo Dog	!PRERACE:1,%
NAME:Foo Dog
STAT:STR=11|DEX=11|CON=11|INT=10|WIS=10|CHA=10


